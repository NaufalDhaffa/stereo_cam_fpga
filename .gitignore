__pycache__/
*.pyc
.Xil/
*.jou
*.log
# build outputs: only the mini system's bitstream, its tables and the SD card content are kept
/build/*
!/build/mini/
!/build/golden_minisys/
!/build/sdcard/
/build/mini/vivado/
# test runs
/asic/tt/test/sim_build/
/asic/tt/test/results.xml
/asic/tt/test/*.fst
/fx2/uvc/obj/
!/build/mini1/
!/build/golden_mini1sys/
/build/mini1/vivado/
# Vivado projects: the block design and the project file are kept, everything generated is not
/hw/projects/*/*.cache/
/hw/projects/*/*.gen/
/hw/projects/*/*.hw/
/hw/projects/*/*.ip_user_files/
/hw/projects/*/*.runs/
/hw/projects/*/*.sim/
/hw/export/*/*.bif
# Vitis workspaces: made by sw/scripts/create_workspace.py
/sw/workspace_*/
!/build/bootbin/
